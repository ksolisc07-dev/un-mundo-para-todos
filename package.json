{
  "name": "un-mundo-para-todos",
  "version": "0.1.0",
  "description": "Plataforma educativa inclusiva, gratuita y de código abierto para aprender jugando.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node tests/server.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "lint": "eslint js tests sw.js playwright.config.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "eslint": "^10.1.0"
  }
}
